function h38TaskRuleToggle_(ruleId,enabled){var user=h38TaskRuleRequireManager_(),before=h38TaskRuleRows_(true).find(function(row){return row['Rule ID']===ruleId;});boAssert_(before,'The selected assignment rule was not found.');var record=Object.assign({},before,{Status:enabled?'Active':'Inactive','Updated Time':h38TaskRuleNow_()});delete record.__rowNumber;h38TaskRuleWrite_(record,before.__rowNumber);boAudit_('UPDATE',H38_TASK_RULES_SHEET,ruleId,before,record,'Task assignment rule status');boProof_('TASK_RULE_TOGGLE','Task Assignment Rule',ruleId,'PASS',(enabled?'Enabled':'Disabled')+' internal assignment rule.',user.Email);return record;}
function h38TaskRuleRecordId_(module,row){var map={requests:'Request ID',quotes:'Quote ID',jobs:'Job ID',invoices:'Invoice ID',payments:'Payment ID'};return boNormalizeText_(row[map[module]]||'');}
function h38TaskRuleRecordType_(module){var map={requests:'Request',quotes:'Quote',jobs:'Job',invoices:'Invoice',payments:'Payment'};return map[module]||'';}
function h38TaskRuleRecordLabel_(module,row){return boNormalizeText_(row.Name||row['Project Title']||row['Quote Number']||row['Job Number']||row['Invoice Number']||row['Payment ID']||h38TaskRuleRecordId_(module,row));}
function h38TaskRuleTemplate_(template,module,row){var id=h38TaskRuleRecordId_(module,row),values={record:h38TaskRuleRecordType_(module),id:id,name:h38TaskRuleRecordLabel_(module,row),customer:boNormalizeText_(row['Customer ID']),status:boNormalizeText_(row.Status||row.Stage||row['Approval Status']),number:boNormalizeText_(row['Quote Number']||row['Job Number']||row['Invoice Number']||id)};return String(template||'').replace(/\{(record|id|name|customer|status|number)\}/g,function(_,key){return values[key]||'';}).trim();}
function h38TaskRuleDate_(offset){var date=new Date();date.setHours(0,0,0,0);date.setDate(date.getDate()+Math.max(0,Number(offset)||0));return Utilities.formatDate(date,boPackValue_('business.timeZone','America/Chicago'),'yyyy-MM-dd');}
function h38TaskRuleMatches_(rule,row){var field=boNormalizeText_(rule['Match Field']),expected=boNormalizeText_(rule['Match Value']).toLowerCase();if(!field||!expected)return true;return boNormalizeText_(row[field]).toLowerCase().indexOf(expected)>=0;}
