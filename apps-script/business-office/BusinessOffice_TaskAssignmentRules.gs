function h38TaskRuleWorkload_(){var rows=h38TmListTasks_({limit:1000}),open=rows.filter(function(row){return !/^(Completed|Cancelled)$/i.test(row.Status);}),users=h38PortalTaskMessagingAssignees(),items=[];(users.users||[]).forEach(function(user){var assigned=open.filter(function(row){return row['Assigned User ID']===user.id;});items.push({key:user.id,label:user.name,type:'User',open:assigned.length,urgent:assigned.filter(function(row){return row.Priority==='Urgent'||row.Priority==='High';}).length,overdue:assigned.filter(function(row){return row['Display Status']==='Overdue';}).length});});(users.roles||[]).forEach(function(role){var assigned=open.filter(function(row){return !row['Assigned User ID']&&row['Assigned Role']===role.name;});items.push({key:role.name,label:role.name,type:'Role',open:assigned.length,urgent:assigned.filter(function(row){return row.Priority==='Urgent'||row.Priority==='High';}).length,overdue:assigned.filter(function(row){return row['Display Status']==='Overdue';}).length});});return {open:open.length,completed:rows.length-open.length,items:items};}
