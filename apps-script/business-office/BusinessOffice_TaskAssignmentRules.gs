  'Task Title':h38TaskRuleTemplate_(rule['Task Title Template'],module,row),
  'Task Type':rule['Task Type']||'Workflow',
  'Assigned User ID':rule['Assigned User ID']||'',
  'Assigned Role':rule['Assigned Role']||'',
