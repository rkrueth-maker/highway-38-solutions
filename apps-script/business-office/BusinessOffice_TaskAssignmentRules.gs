function h38TaskRuleStatusText_(row){return [row.Status,row.Stage,row['Approval Status'],row['Customer Action'],row['Delivery Status']].join(' ').toLowerCase();}
function h38TaskRuleBalance_(row){var direct=Number(String(row['Balance Due']||'').replace(/[$,]/g,''));if(Number.isFinite(direct))return direct;var total=Number(String(row.Total||0).replace(/[$,]/g,''))||0,paid=Number(String(row['Amount Paid']||row.Paid||0).replace(/[$,]/g,''))||0;return Math.max(0,total-paid);}
function h38TaskRulePast_(value){var parsed=Date.parse(boNormalizeText_(value));if(!Number.isFinite(parsed))return false;var today=new Date();today.setHours(0,0,0,0);return parsed<today.getTime();}
function h38TaskRuleCandidates_(trigger){var spec=h38TaskRuleTrigger_(trigger),rows=boListRecords(spec.module,{limit:1000,includeVoided:false});if(trigger==='quote.approved')return rows.filter(function(row){return /approved|accepted/.test(h38TaskRuleStatusText_(row));});if(trigger==='job.completed')return rows.filter(function(row){return /complete|completed|closed/.test(h38TaskRuleStatusText_(row));});if(trigger==='invoice.overdue')return rows.filter(function(row){return h38TaskRuleBalance_(row)>0&&(h38TaskRulePast_(row['Due Date'])||/overdue/.test(h38TaskRuleStatusText_(row)));});if(trigger==='payment.review')return rows.filter(function(row){return /required|review/.test(boNormalizeText_(row['Approval Status']).toLowerCase());});return rows;}
function h38TaskRuleEventsForSave_(module,before,saved){var events=[],afterText=h38TaskRuleStatusText_(saved||{}),beforeText=h38TaskRuleStatusText_(before||{});if(!before){if(module==='requests')events.push('request.created');if(module==='jobs')events.push('job.created');if(module==='invoices')events.push('invoice.created');}if(module==='quotes'&&/approved|accepted/.test(afterText)&&!/approved|accepted/.test(beforeText))events.push('quote.approved');if(module==='jobs'&&/complete|completed|closed/.test(afterText)&&!/complete|completed|closed/.test(beforeText))events.push('job.completed');if(module==='payments'&&/required|review/.test(boNormalizeText_((saved||{})['Approval Status']).toLowerCase())&&!/required|review/.test(boNormalizeText_((before||{})['Approval Status']).toLowerCase()))events.push('payment.review');return events;}
