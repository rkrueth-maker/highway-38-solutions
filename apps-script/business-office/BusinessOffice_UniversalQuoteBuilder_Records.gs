      var def=H38_UQB_STORE.SHEETS[key],existing=boGetSpreadsheet_().getSheetByName(def.name),sheet=boUniversalStoreSheet_(key,true);
      if(!existing)created.push(def.name);
      var headers=sheet.getRange(1,1,1,sheet.getLastColumn()).getDisplayValues()[0];
      def.headers.forEach(function(header){
        if(headers.indexOf(header)<0){sheet.insertColumnAfter(sheet.getLastColumn());sheet.getRange(1,sheet.getLastColumn()).setValue(header);headers.push(header);}
