function cbCompletionSaveSetting_(request){
  var input=request||{},context=cbCompletionContext_(input.businessId,'manageSettings'),key=cbText_(input.settingKey),now=cbNow_();cbAssert_(key,'Setting key is required.');var existing=cbRows_(context.core,'settings').find(function(row){return row['Setting Key']===key;}),id=existing?existing['Setting ID']:cbUuid_('SETTING'),record={'Setting ID':id,'Business ID':context.row['Business ID'],'Setting Key':key,'Setting Value':typeof input.settingValue==='string'?input.settingValue:JSON.stringify(input.settingValue),'Updated By':context.user.userId,'Updated Time':now,'Record Version':existing?Math.max(1,Number(existing['Record Version']||1))+1:1};if(existing)cbPlatformUpdateRow_(context.core,'settings',existing.__row,record);else cbAppend_(context.core,'settings',record);cbAudit_(context.row['Business ID'],'SAVE SETTING','Setting',id,'PASS','Business setting saved.');return{status:'PASS',settingId:id};
}
