function cbCompletionApproveSocialPost_(request){
  var input=request||{},context=cbCompletionContext_(input.businessId,'manageSocial');cbAssert_(context.user.owner||cbCompletionCan_(context.user,'manageSettings'),'Owner or administrator approval is required.');var post=cbPlatformFindRow_(context.core,'socialPosts','Social Post ID',input.socialPostId),now=cbNow_();cbAssert_(post,'Social post was not found.');var decision=cbText_(input.decision).toUpperCase()==='REJECT'?'Rejected':'Approved';cbPlatformUpdateRow_(context.core,'socialPosts',post.__row,{'Status':decision==='Approved'?(post['Scheduled Time']?'Scheduled':'Owner Approved'):'Changes Requested','Approved By':decision==='Approved'?context.user.userId:'','Approved Time':decision==='Approved'?now:'','Updated Time':now,'Record Version':Math.max(1,Number(post['Record Version']||1))+1});var pending=cbRows_(context.core,'socialApprovals').filter(function(row){return row['Social Post ID']===post['Social Post ID']&&row.Decision==='Pending';});pending.forEach(function(row){cbPlatformUpdateRow_(context.core,'socialApprovals',row.__row,{'Decision':decision,'Decided By':context.user.userId,'Decided Time':now,'Notes':cbText_(input.notes)||row.Notes,'Record Version':Math.max(1,Number(row['Record Version']||1))+1});});cbAudit_(context.row['Business ID'],'DECIDE SOCIAL POST','Social Post',post['Social Post ID'],'PASS','Social review decision recorded. No publication occurred.');return{status:'PASS',decision:decision,message:'Decision recorded. Nothing published.'};
