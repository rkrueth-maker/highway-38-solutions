function cbCompletionSaveCampaign_(request){
  var input=request||{},context=cbCompletionContext_(input.businessId,'manageSocial'),record={'Campaign ID':cbText_(input.campaignId)||cbUuid_('CAMPAIGN'),'Business ID':context.row['Business ID'],'Campaign Name':cbText_(input.campaignName),'Campaign Type':cbText_(input.campaignType)||'Organic','Start Date':cbText_(input.startDate),'End Date':cbText_(input.endDate),'Budget':Number(input.budget||0),'Status':cbText_(input.status)||'Active','Goal':cbText_(input.goal),'Notes':cbText_(input.notes)};cbAssert_(record['Campaign Name'],'Campaign name is required.');var result=cbCompletionUpsert_(context,'core','campaigns','Campaign ID','CAMPAIGN',record,input);if(result.status==='PASS')cbAudit_(context.row['Business ID'],'SAVE SOCIAL CAMPAIGN','Campaign',result.recordId,'PASS','Social campaign saved.');return result;
}
function cbCompletionSaveSocialAccount_(request){
  var input=request||{},context=cbCompletionContext_(input.businessId,'manageSocial'),record={'Social Account ID':cbText_(input.socialAccountId)||cbUuid_('SOCIAL-ACCOUNT'),'Business ID':context.row['Business ID'],'Platform':cbText_(input.platform),'Account Name':cbText_(input.accountName),'Provider':cbText_(input.provider)||'Provider Neutral','Provider Account ID':cbText_(input.providerAccountId),'Connection Status':cbText_(input.connectionStatus)||'Not Connected','Status':cbText_(input.status)||'Active'};cbAssert_(record.Platform&&record['Account Name'],'Platform and account name are required.');return cbCompletionUpsert_(context,'core','socialAccounts','Social Account ID','SOCIAL-ACCOUNT',record,input);
