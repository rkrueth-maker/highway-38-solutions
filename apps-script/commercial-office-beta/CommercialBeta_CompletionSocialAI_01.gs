function cbCompletionRequestSocialReview_(request){
  var input=request||{},context=cbCompletionContext_(input.businessId,'manageSocial'),post=cbPlatformFindRow_(context.core,'socialPosts','Social Post ID',input.socialPostId),now=cbNow_();cbAssert_(post,'Social post was not found.');cbPlatformUpdateRow_(context.core,'socialPosts',post.__row,{'Status':'Pending Review','Updated Time':now,'Record Version':Math.max(1,Number(post['Record Version']||1))+1});var id=cbUuid_('SOCIAL-APPROVAL');cbAppend_(context.core,'socialApprovals',{'Social Approval ID':id,'Business ID':context.row['Business ID'],'Social Post ID':post['Social Post ID'],'Decision':'Pending','Requested By':context.user.userId,'Decided By':'','Requested Time':now,'Decided Time':'','Notes':cbText_(input.notes),'Record Version':1});return{status:'PASS',approvalId:id};
