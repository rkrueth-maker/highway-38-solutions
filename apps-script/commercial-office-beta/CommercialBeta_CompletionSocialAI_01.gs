function cbCompletionScheduleSocialPost_(request){
  var input=request||{},context=cbCompletionContext_(input.businessId,'manageSocial'),post=cbPlatformFindRow_(context.core,'socialPosts','Social Post ID',input.socialPostId),scheduled=cbText_(input.scheduledTime),now=cbNow_();cbAssert_(post,'Social post was not found.');cbAssert_(scheduled,'Scheduled time is required.');cbPlatformUpdateRow_(context.core,'socialPosts',post.__row,{'Scheduled Time':scheduled,'Status':post['Approved By']?'Scheduled':'Draft Scheduled — Approval Required','Updated Time':now,'Record Version':Math.max(1,Number(post['Record Version']||1))+1});return{status:'PASS',message:'Schedule recorded internally. Automatic publishing remains disabled.'};
