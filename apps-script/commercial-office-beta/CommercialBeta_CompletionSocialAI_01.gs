function cbCompletionSaveSocialPost_(request){
  var input=request||{},context=cbCompletionContext_(input.businessId,'manageSocial'),body=cbText_(input.body),now=cbNow_();cbAssert_(body,'Social post content is required.');var id=cbText_(input.socialPostId)||cbUuid_('SOCIAL-POST'),existing=cbPlatformFindRow_(context.core,'socialPosts','Social Post ID',id),status=cbText_(input.status)||(existing?existing.Status:'Draft'),record={'Social Post ID':id,'Business ID':context.row['Business ID'],'Campaign ID':cbText_(input.campaignId),'Platform':cbText_(input.platform)||'General','Account ID':cbText_(input.accountId),'Title':cbText_(input.title),'Body':body,'Asset Document IDs JSON':JSON.stringify(input.assetDocumentIds||[]),'Link URL':cbText_(input.linkUrl),'Post Type':cbText_(input.postType)||'Standard','Status':status,'Scheduled Time':cbText_(input.scheduledTime),'Approved By':existing?existing['Approved By']:'','Approved Time':existing?existing['Approved Time']:'','Published Time':existing?existing['Published Time']:'','Provider Post ID':existing?existing['Provider Post ID']:'','Manual Proof Document ID':cbText_(input.manualProofDocumentId)||(existing?existing['Manual Proof Document ID']:''),'Created By':existing?existing['Created By']:context.user.userId,'Updated Time':now,'Record Version':existing?Math.max(1,Number(existing['Record Version']||1))+1:1};if(existing)cbPlatformUpdateRow_(context.core,'socialPosts',existing.__row,record);else{record['Created Time']=now;cbAppend_(context.core,'socialPosts',record);}cbAudit_(context.row['Business ID'],'SAVE SOCIAL DRAFT','Social Post',id,'PASS','Social content saved internally; nothing published.');return{status:'PASS',socialPostId:id,message:'Social draft saved. Nothing published.'};
