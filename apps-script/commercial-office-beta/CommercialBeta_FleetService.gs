/** Fleet, equipment, assignment, inspection, maintenance and usage services. */
function cbFleetUpdateAsset_(context,assetId,updates){var row=cbPlatformFindRow_(context.assets,'assets','Asset ID',assetId);cbAssert_(row,'Equipment was not found.');updates['Updated Time']=cbNow_();updates['Record Version']=Math.max(1,Number(row['Record Version']||1))+1;cbPlatformUpdateRow_(context.assets,'assets',row.__row,updates);return row;}
function cbAssignAssetToJob_(request){
  var input=request||{},context=cbPlatformContext_(input.businessId),assetId=cbText_(input.assetId),jobId=cbText_(input.jobId),asset=cbPlatformFindRow_(context.assets,'assets','Asset ID',assetId),job=cbPlatformFindRow_(context.core,'jobs','Job ID',jobId),now=cbNow_();cbAssert_(asset,'Equipment was not found.');cbAssert_(job,'Job was not found.');cbAssert_(cbText_(asset.Availability).toUpperCase()==='AVAILABLE'||!cbText_(asset.Availability),'Equipment is not available.');
  var assignmentId=cbUuid_('ASSIGNMENT');cbAppend_(context.assets,'assignments',{'Asset Assignment ID':assignmentId,'Business ID':context.row['Business ID'],'Asset ID':assetId,'User ID':cbText_(input.userId),'Crew ID':cbText_(input.crewId),'Truck ID':cbText_(input.truckId),'Job ID':jobId,'Location ID':cbText_(input.locationId),'Assignment Type':cbText_(input.assignmentType)||'Job','Assigned Time':now,'Returned Time':'','Status':'Active','Condition Out':cbText_(input.conditionOut),'Condition In':'','Created By':cbCurrentEmail_(),'Updated By':cbCurrentEmail_(),'Record Version':1});
  cbAppend_(context.assets,'jobEquipment',{'Job Equipment ID':cbUuid_('JOB-EQUIPMENT'),'Business ID':context.row['Business ID'],'Job ID':jobId,'Asset ID':assetId,'Requirement Type':cbText_(input.requirementType)||'Assigned','Quantity':1,'Status':'Assigned','Assigned Time':now,'Returned Time':'','Assigned By':cbCurrentEmail_(),'Notes':cbText_(input.notes),'Created Time':now,'Updated Time':now,'Record Version':1});cbFleetUpdateAsset_(context,assetId,{'Assigned Job ID':jobId,'Assigned User ID':cbText_(input.userId),'Assigned Crew ID':cbText_(input.crewId),'Availability':'Assigned'});cbAudit_(context.row['Business ID'],'ASSIGN EQUIPMENT TO JOB','Asset Assignment',assignmentId,'PASS','Equipment assigned to '+job['Job Number']+'.');return{status:'PASS',message:'Equipment assigned to job.',assignmentId:assignmentId,assetId:assetId,jobId:jobId};
}
function cbReturnAssetFromJob_(request){
  var input=request||{},context=cbPlatformContext_(input.businessId),assetId=cbText_(input.assetId),rows=cbRows_(context.assets,'assignments').filter(function(row){return row['Asset ID']===assetId&&cbText_(row.Status).toUpperCase()==='ACTIVE'&&!row['Returned Time'];}),now=cbNow_();cbAssert_(rows.length,'No active equipment assignment was found.');rows.forEach(function(row){cbPlatformUpdateRow_(context.assets,'assignments',row.__row,{'Returned Time':now,'Status':'Returned','Condition In':cbText_(input.conditionIn),'Updated By':cbCurrentEmail_(),'Record Version':Math.max(1,Number(row['Record Version']||1))+1});});cbRows_(context.assets,'jobEquipment').filter(function(row){return row['Asset ID']===assetId&&cbText_(row.Status).toUpperCase()==='ASSIGNED';}).forEach(function(row){cbPlatformUpdateRow_(context.assets,'jobEquipment',row.__row,{'Returned Time':now,'Status':'Returned','Updated Time':now,'Record Version':Math.max(1,Number(row['Record Version']||1))+1});});cbFleetUpdateAsset_(context,assetId,{'Assigned Job ID':'','Assigned User ID':'','Assigned Crew ID':'','Availability':cbText_(input.holdReason)?'Hold':'Available','Status':cbText_(input.holdReason)?'Needs Review':'Active'});cbAudit_(context.row['Business ID'],'RETURN EQUIPMENT','Asset',assetId,'PASS','Equipment returned from job.');return{status:'PASS',message:'Equipment returned.',assetId:assetId};
}
function cbScheduleMaintenance_(request){
  var input=request||{},context=cbPlatformContext_(input.businessId),assetId=cbText_(input.assetId),now=cbNow_();cbAssert_(cbPlatformFindRow_(context.assets,'assets','Asset ID',assetId),'Equipment was not found.');var maintenanceId=cbUuid_('MAINTENANCE'),status=cbText_(input.status)||'Scheduled';cbAppend_(context.assets,'maintenance',{'Maintenance ID':maintenanceId,'Business ID':context.row['Business ID'],'Asset ID':assetId,'Maintenance Type':cbText_(input.maintenanceType)||'Service','Status':status,'Priority':cbText_(input.priority)||'Normal','Due Date':cbText_(input.dueDate),'Due Meter':Number(input.dueMeter||0),'Completed Date':'','Vendor ID':cbText_(input.vendorId),'Labor Hours':'','Parts Cost':'','Labor Cost':'','Downtime Hours':'','Notes':cbText_(input.notes),'Created Time':now,'Updated Time':now,'Record Version':1});cbFleetUpdateAsset_(context,assetId,{'Next Service':cbText_(input.dueDate),'Availability':status.toUpperCase()==='IN PROGRESS'?'Maintenance':(cbPlatformFindRow_(context.assets,'assets','Asset ID',assetId).Availability||'Available')});cbAudit_(context.row['Business ID'],'SCHEDULE MAINTENANCE','Maintenance',maintenanceId,'PASS','Maintenance scheduled.');return{status:'PASS',message:'Maintenance scheduled.',maintenanceId:maintenanceId};
}
function cbCompleteMaintenance_(request){var input=request||{},context=cbPlatformContext_(input.businessId),row=cbPlatformFindRow_(context.assets,'maintenance','Maintenance ID',input.maintenanceId),now=cbNow_();cbAssert_(row,'Maintenance record was not found.');cbPlatformUpdateRow_(context.assets,'maintenance',row.__row,{'Status':'Complete','Completed Date':cbText_(input.completedDate)||now,'Labor Hours':Number(input.laborHours||0),'Parts Cost':Number(input.partsCost||0),'Labor Cost':Number(input.laborCost||0),'Downtime Hours':Number(input.downtimeHours||0),'Notes':cbText_(input.notes)||row.Notes,'Updated Time':now,'Record Version':Math.max(1,Number(row['Record Version']||1))+1});cbFleetUpdateAsset_(context,row['Asset ID'],{'Last Service':cbText_(input.completedDate)||now,'Next Service':cbText_(input.nextService),'Availability':'Available','Status':'Active'});cbAudit_(context.row['Business ID'],'COMPLETE MAINTENANCE','Maintenance',input.maintenanceId,'PASS','Maintenance completed.');return{status:'PASS',message:'Maintenance completed.',maintenanceId:input.maintenanceId};}
function cbRecordInspection_(request){var input=request||{},context=cbPlatformContext_(input.businessId),assetId=cbText_(input.assetId),result=cbText_(input.result).toUpperCase()||'PASS',now=cbNow_();cbAssert_(cbPlatformFindRow_(context.assets,'assets','Asset ID',assetId),'Equipment was not found.');var inspectionId=cbUuid_('INSPECTION');cbAppend_(context.assets,'inspections',{'Inspection ID':inspectionId,'Business ID':context.row['Business ID'],'Asset ID':assetId,'Inspection Type':cbText_(input.inspectionType)||'Routine','Result':result,'Meter Reading':Number(input.meterReading||0),'Mileage':Number(input.mileage||0),'Notes':cbText_(input.notes),'Document IDs JSON':'[]','Inspected By':cbCurrentEmail_(),'Inspection Time':now,'Record Version':1});if(result==='FAIL')cbFleetUpdateAsset_(context,assetId,{'Availability':'Inspection Hold','Status':'Needs Service'});cbAudit_(context.row['Business ID'],'RECORD INSPECTION','Inspection',inspectionId,result==='FAIL'?'HOLD':'PASS','Equipment inspection recorded.');return{status:'PASS',message:result==='FAIL'?'Inspection recorded; equipment placed on hold.':'Inspection recorded.',inspectionId:inspectionId};}
function cbRecordAssetUsage_(request){var input=request||{},context=cbPlatformContext_(input.businessId),assetId=cbText_(input.assetId),now=cbNow_();cbAssert_(cbPlatformFindRow_(context.assets,'assets','Asset ID',assetId),'Equipment was not found.');var usageId=cbUuid_('USAGE');cbAppend_(context.assets,'usageLogs',{'Usage Log ID':usageId,'Business ID':context.row['Business ID'],'Asset ID':assetId,'Job ID':cbText_(input.jobId),'User ID':cbText_(input.userId)||'USER-OWNER','Start Time':cbText_(input.startTime),'End Time':cbText_(input.endTime)||now,'Start Meter':Number(input.startMeter||0),'End Meter':Number(input.endMeter||0),'Start Mileage':Number(input.startMileage||0),'End Mileage':Number(input.endMileage||0),'Usage Type':cbText_(input.usageType)||'Job','Notes':cbText_(input.notes),'Offline Operation ID':cbText_(input.offlineOperationId),'Record Version':1});var updates={};if(Number(input.endMeter||0)>0)updates['Meter Hours']=Number(input.endMeter);if(Number(input.endMileage||0)>0)updates.Mileage=Number(input.endMileage);if(Object.keys(updates).length)cbFleetUpdateAsset_(context,assetId,updates);cbAudit_(context.row['Business ID'],'RECORD ASSET USAGE','Usage Log',usageId,'PASS','Equipment usage recorded against a job.');return{status:'PASS',message:'Usage recorded.',usageId:usageId};}
