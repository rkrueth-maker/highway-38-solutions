function cbDemo8Dxf_(title,width,height,extras){
 var out=['0','SECTION','2','HEADER','9','$ACADVER','1','AC1009','0','ENDSEC','0','SECTION','2','ENTITIES'];
 function line(x1,y1,x2,y2,layer){out.push('0','LINE','8',layer||'PLAN','10',String(x1),'20',String(y1),'30','0','11',String(x2),'21',String(y2),'31','0');}
 function rect(x,y,w,h,layer){line(x,y,x+w,y,layer);line(x+w,y,x+w,y+h,layer);line(x+w,y+h,x,y+h,layer);line(x,y+h,x,y,layer);}
 function text(x,y,value){out.push('0','TEXT','8','NOTES','10',String(x),'20',String(y),'30','0','40','1','1',String(value));}
 rect(0,0,width,height,'OUTLINE');text(0,height+3,title);text(0,-3,'CONTROLLED DEMO CAD — VERIFY ALL FIELD DIMENSIONS');
 (extras||[]).forEach(function(item){rect(item[0],item[1],item[2],item[3],item[4]||'DETAIL');if(item[5])text(item[0],item[1]+item[3]+1,item[5]);});
 out.push('0','ENDSEC','0','EOF');return out.join('\n');
}
