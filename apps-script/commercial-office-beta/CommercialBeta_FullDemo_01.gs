function cbDemo8Upsert_(context,bookKey,sheet,idField,id,record){
 var book=cbDemo8Book_(context,bookKey),headers=cbCompletionHeaders_(book,sheet),existing=cbPlatformFindRow_(book,sheet,idField,id),now=cbNow_(),out={};
 headers.forEach(function(header){if(Object.prototype.hasOwnProperty.call(record,header))out[header]=record[header];});out[idField]=id;if(headers.indexOf('Business ID')>=0)out['Business ID']=context.row['Business ID'];if(headers.indexOf('Updated Time')>=0)out['Updated Time']=now;if(headers.indexOf('Record Version')>=0)out['Record Version']=existing?Math.max(1,Number(existing['Record Version']||1))+1:1;
 if(existing)cbPlatformUpdateRow_(book,sheet,existing.__row,out);else{if(headers.indexOf('Created Time')>=0)out['Created Time']=now;if(headers.indexOf('Created By')>=0&&!out['Created By'])out['Created By']=context.user.userId;cbAppend_(book,sheet,out);}return id;
}
