{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highway38solutions.com/schemas/commercial-beta-installation-manifest-v2.json",
  "title": "Highway 38 Commercial Office Beta Installation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "installationId",
    "idempotencyKey",
    "businessId",
    "businessName",
    "ownerEmail",
    "environment",
    "industryPack",
    "primaryIndustryPack",
    "industryPacks",
    "enabledModules",
    "driveRootId",
    "coreSpreadsheetId",
    "inventorySpreadsheetId",
    "assetSpreadsheetId",
    "backupFolderId",
    "schemaVersion",
    "installerVersion",
    "status",
    "lastVerificationResult",
    "productionDataMigrated",
    "externalActionsEnabled",
    "createdBy",
    "createdTime",
    "updatedTime"
  ],
  "properties": {
    "installationId": {"type": "string", "minLength": 8},
    "idempotencyKey": {"type": "string", "minLength": 8},
    "businessId": {"type": "string", "minLength": 6},
    "businessName": {"type": "string", "minLength": 1},
    "ownerEmail": {"type": "string", "format": "email"},
    "environment": {"const": "commercial-google-native-beta"},
    "industryPack": {"type": "string", "minLength": 1},
    "primaryIndustryPack": {"type": "string", "minLength": 1},
    "industryPacks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "enabledModules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "driveRootId": {"type": "string", "minLength": 10},
    "coreSpreadsheetId": {"type": "string", "minLength": 10},
    "inventorySpreadsheetId": {"type": "string", "minLength": 10},
    "assetSpreadsheetId": {"type": "string", "minLength": 10},
    "backupFolderId": {"type": "string", "minLength": 10},
    "manifestFileId": {"type": "string"},
    "schemaVersion": {"type": "integer", "minimum": 2},
    "installerVersion": {"type": "string"},
    "status": {"enum": ["Provisioning", "Provisioned", "Verified", "Needs Repair", "Disabled"]},
    "lastVerificationResult": {"enum": ["PENDING", "PASS", "FAIL"]},
    "productionDataMigrated": {"const": false},
    "externalActionsEnabled": {"const": false},
    "createdBy": {"type": "string", "format": "email"},
    "createdTime": {"type": "string", "format": "date-time"},
    "updatedTime": {"type": "string", "format": "date-time"}
  }
}
